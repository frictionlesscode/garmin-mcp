GARMIN_TOKEN_DIR=/data/garth
# Used as the one-time login-form password for OAuth clients (see oauth.py) --
# no longer sent on every request once a client has an access token.
MCP_BEARER_TOKEN=
# The public URL this server is actually reachable at (Tailscale Funnel /
# Cloudflare Tunnel / etc). Required for correct OAuth issuer/redirect URLs.
MCP_PUBLIC_URL=
# Path to GarminDB's own garmin.db (produced by scripts/sync_garmindb.py),
# not a separate database we maintain.
SQLITE_PATH=/data/garmindb/DBs/garmin.db
TZ=America/New_York
LOG_LEVEL=INFO
